{
  "buildCommand": "",
  "installCommand": "true",
  "outputDirectory": "site",
  "functions": {
    "api/*.py": {
      "maxDuration": 10,
      "includeFiles": "scopelock/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
